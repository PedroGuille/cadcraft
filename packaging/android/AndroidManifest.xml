<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.storytold.cadcraft"
    android:versionCode="7017" android:versionName="0.1.4">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <supports-screens android:smallScreens="false" android:normalScreens="true"
        android:largeScreens="true" android:xlargeScreens="true" android:anyDensity="true" />
    <application android:label="CADCraft Tablet Preview" android:icon="@mipmap/cadcraft"
        android:theme="@style/CADCraftTheme" android:allowBackup="false"
        android:hasCode="true" android:extractNativeLibs="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask" android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|density|uiMode|locale|layoutDirection|fontScale|mcc|mnc"
            android:resizeableActivity="true" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="cadcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity$CommandActivity" android:exported="false"
            android:theme="@style/CADCommandTheme" android:windowSoftInputMode="adjustResize" />
        <provider android:name=".ShareProvider" android:authorities="io.github.storytold.cadcraft.share"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
